      "next_state": "track_order_init"
    },
    {
      "id": "invoice",
      "keywords": ["invoice", "download invoice", "bill", "receipt"],
      "next_state": "invoice_init"
    },
    {
      "id": "shipping_help",
      "keywords": ["shipping", "delivery", "dispatch", "courier"],
      "next_state": "shipping_help"
    },
    {
      "id": "support",
      "keywords": ["support", "contact", "talk to human", "customer care"],
      "next_state": "human_handoff"
    }
