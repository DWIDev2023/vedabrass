    {
      "id": "browse_products",
      "keywords": ["browse products", "show products", "shop", "buy product", "catalog"],
      "next_state": "browse_category_select"
    },
    {
      "id": "recommend_products",
      "keywords": ["recommend products", "suggest product", "help me choose", "gift suggestion"],
      "next_state": "recommendation_usecase"
    },
    {
